# ============================================================
# FEEDBACK — Environment variables
# Copy to `.env` (which is gitignored). Vite exposes any var
# prefixed with VITE_ to the browser bundle, so DO NOT prefix
# secrets (service role, Bold webhook secret) with VITE_.
# ============================================================

# --- Supabase (browser-safe) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-public-key...

# --- Bold (browser-safe identity only) ---
# Public identity key used to render the Bold button. Never expose the
# secret key here. Leave blank until Phase 4 wires real Bold integration —
# until then VITE_PAYMENTS_MODE should NOT be 'bold' and the checkout
# flow is intentionally disabled in `src/data/payments.js`.
VITE_BOLD_API_KEY=
VITE_PAYMENTS_MODE=disabled

# --- Web Push (browser-safe) ---
# VAPID public key embedded in the bundle so PushManager.subscribe() can
# encrypt against it. Generate with `npx web-push generate-vapid-keys`
# (the same command also outputs the PRIVATE key — that one goes ONLY
# into Supabase secrets as VAPID_PRIVATE_KEY, never here).
# The CI deploy workflow must also have VITE_VAPID_PUBLIC_KEY set as a
# GitHub Actions secret, otherwise the production build embeds `undefined`
# and the permission modal will say "Falta configuración (VAPID)".
VITE_VAPID_PUBLIC_KEY=

# ============================================================
# Server-only (set via `supabase secrets set` for Edge Functions,
# NOT in .env files that ship to the browser).
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...service-role...
# BOLD_API_KEY=your-bold-api-key
# BOLD_SECRET_KEY=your-bold-secret-key
# BOLD_WEBHOOK_SECRET=your-bold-webhook-secret
# BOLD_REDIRECT_BASE_URL=https://partyrate.site/membership/success
